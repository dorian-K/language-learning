# BBC Noticias cron jobs — fires for bbc-cron container
#
# Each entry calls `python -m src.bbc_noticias.cron publish`
# which writes to /app/shared/queue.json

PATH=/usr/local/bin:/usr/bin:/bin
SHARED_QUEUE_PATH=/app/shared/queue.json

# at 8am every day
0 8 * * * root cd /app && /app/.venv/bin/python -m src.bbc_noticias.cron publish >> /app/cron.log 2>&1